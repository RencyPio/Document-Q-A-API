# Answer generation. Groq has a free tier: get a key at https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
# Optional: change the model (default openai/gpt-oss-120b; openai/gpt-oss-20b is smaller and faster)
# LLM_MODEL=openai/gpt-oss-120b

# To use OpenAI instead (paid, needs prepaid credit):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Any other OpenAI-compatible API: set LLM_BASE_URL, LLM_API_KEY and LLM_MODEL.

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=./data/chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
